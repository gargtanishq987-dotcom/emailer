# ============================================================
# COLD EMAIL PLATFORM — ENVIRONMENT VARIABLES
# Copy to client/.env.local and fill in all values
# ============================================================

# --- Admin Auth ---
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD_HASH=$2b$12$...  # bcrypt hash — run: node scripts/hash-password.js yourpassword

# --- Session ---
SESSION_SECRET=change-this-to-a-32-char-random-secret-string-here!!

# --- Firebase Client (public) ---
NEXT_PUBLIC_FIREBASE_API_KEY=AIza...
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890
NEXT_PUBLIC_FIREBASE_APP_ID=1:123:web:abc

# --- Firebase Admin (server-only) ---
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"

# --- Google OAuth (for Gmail account connections) ---
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# --- Encryption (for refresh tokens at rest) ---
ENCRYPTION_KEY=32-char-random-hex-key-here-xxxxxx

# --- Apps Script Worker Secret (shared between Next.js and Apps Script) ---
WORKER_SECRET=random-secret-for-apps-script-api-calls

# --- Next.js ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
